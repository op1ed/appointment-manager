<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- 全局阅读第一批：这是 Maven 的构建说明文件。先认识每组依赖的用途，后续再看具体 API。
         Maven 按这里的声明准备所需的库，并编译、测试、打包项目。
         modelVersion 是本文件使用的 Maven 模型格式版本。 -->
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承 Spring Boot 提供的构建与依赖版本约定，减少项目需要单独维护的版本配置。 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <!-- 项目的构建标识：组织、项目名称、当前开发版本。 -->
    <groupId>com.op1ed</groupId>
    <artifactId>appointment-manager</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <!-- 集中声明版本变量；下方 ${变量名} 会引用这里的值。 -->
    <properties>
        <java.version>21</java.version>
        <spring-ai.version>1.1.2</spring-ai.version>
        <spring-ai-alibaba.version>1.1.2.2</spring-ai-alibaba.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
    </properties>

    <!-- BOM 统一约定一组相关依赖的版本。真正使用的库在下方 dependencies 中引入。 -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Agent 框架：ReactAgent 组织模型与工具调用，StateGraph 编排可暂停的改期流程。
             这部分在阅读路线的后段展开；预约业务服务是它调用的业务底座。 -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-agent-framework</artifactId>
            <version>${spring-ai-alibaba.version}</version>
        </dependency>
        <!-- Web：提供 HTTP 接口、请求分派和 JSON 转换，Controller 用它接收和返回数据。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 安全：提供请求认证与访问控制的基础，本项目在 identity 模块中配置登录和权限。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- 测试工具：用于验证接口、业务与集成行为。scope=test 表示只在测试阶段使用。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 架构测试：检查模块和分层依赖是否符合约定，例如业务服务不能依赖 Controller。 -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <version>1.5.1</version>
            <scope>test</scope>
        </dependency>
        
        <!-- 输入校验：支持 @NotNull、@Positive、@Valid 等声明，帮助入口检查请求格式。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        
        <!-- 数据访问：MyBatis-Plus 提供通用 Mapper，复杂查询与行锁使用明确的 SQL。 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <!-- 分页插件独立依赖；所有分页继续在数据库执行。 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- MySQL 驱动：应用运行时通过它与 MySQL 通信，连接参数在 application.properties 中。 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 数据库迁移：按版本执行 resources/db/migration 中尚未执行的 SQL。
             flyway-core 提供迁移机制，flyway-mysql 提供对应的 MySQL 支持。 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>  
    </dependencies>

    <!-- 构建插件：把应用和运行所需的依赖打包成可通过 java -jar 启动的 JAR。 -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
